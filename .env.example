# Copie para .env e ajuste. Lido por web/serve.py e docker compose.
# Porta da versão web (web/serve.py).
PORT=8777
# 127.0.0.1 = só neste computador; 0.0.0.0 = acessível na rede local (iPhone no mesmo Wi-Fi).
HOST=127.0.0.1
# Tempo máximo (s) de cada consulta repassada a VizieR/SkyBoT/SIMBAD.
PROXY_TIMEOUT=90
# DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=INFO
